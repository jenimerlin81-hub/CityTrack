# PORT: Port where Express server runs (defaults to 3000)
PORT=3000

# MONGODB_URI: Optional MongoDB connection string (e.g., mongodb://localhost:27017/citytrack)
# If omitted or offline, CityTrack operates with an in-memory database pre-seeded with full small-city data.
MONGODB_URI="mongodb://localhost:27017/citytrack"

# JWT_SECRET: Secret for signing JWT authentication tokens
JWT_SECRET="citytrack_super_secret_jwt_key_2026"
